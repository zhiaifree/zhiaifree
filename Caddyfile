# 域名从环境变量读取（docker-compose 会传入 DOMAIN）
# Caddy 会自动为该域名申请 Let's Encrypt 证书，到期前自动续期
{$DOMAIN} {
	# 反向代理到 docker-compose 里的 nginx 容器（web 服务）
	reverse_proxy web:80

	# 压缩响应，减小传输体积
	encode zstd gzip

	# 基础安全响应头
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ===== Node.js 项目（宿主机 node 进程，同一域名不同端口对外 HTTPS）=====
# 对外 3000/3001 由 Caddy 提供 TLS；Node 进程监听宿主机 13000/13001（需绑 0.0.0.0，
# 不能监听 3000/3001——已被 Caddy 占用），Caddy 通过 host.docker.internal 转发
# 证书按域名签发、与端口无关，全部端口复用同一张自动续期的证书
{$DOMAIN}:3000 {
	reverse_proxy host.docker.internal:13000
}

{$DOMAIN}:3001 {
	reverse_proxy host.docker.internal:13001
}
