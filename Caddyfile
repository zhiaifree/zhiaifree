# 域名从环境变量读取（docker-compose 会传入 DOMAIN）
# Caddy 会自动为该域名申请 Let's Encrypt 证书，到期前自动续期
{$DOMAIN} {
	# 反向代理到 docker-compose 里的 nginx 容器（web 服务）
	reverse_proxy web:80

	# 压缩响应，减小传输体积
	encode zstd gzip

	# 基础安全响应头
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ===== Node.js 项目（同一域名，不同端口对外提供 HTTPS）=====
# 证书按域名签发、与端口无关，以下端口复用同一张自动续期的证书
# 注意：nodeapp1/nodeapp2 是约定的容器名，实际名称不同请改这里后推送
# Node 容器需加入 shared-apps 网络，且不要映射端口到宿主机（80/443/3000/3001 由 Caddy 独占）
{$DOMAIN}:3000 {
	reverse_proxy nodeapp1:3000
}

{$DOMAIN}:3001 {
	reverse_proxy nodeapp2:3001
}
